# server
PORT=8081
ENV=development

# Postgres (Supabase)
DATABASE_URL=postgres://bitoracdn:password@postgres:5432/bitoracdn

# S3-compatible (Supabase storage)
S3_ENDPOINT=https://<your-supabase-storage-url>   # e.g. nyc3.supabase.co/storage/v1
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=bitoracdn

# JWT for simple origin auth (control-plane -> origin)
ORIGIN_JWT_SECRET=dev_secret

# Upload limits
MAX_UPLOAD_BYTES=104857600   # 100MB
